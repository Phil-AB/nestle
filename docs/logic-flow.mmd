flowchart TD

    A([New Shipment Arrives]) --> B["Register the Shipment"]
    B --> C["Upload Shipping Documents"]
    C --> D["AI Reads All Documents"]
    D --> E["Organise and Standardise Data"]
    E --> F["Save to Database"]

    F --> G["STAGE 1 — Vendor Document Review"]

    G --> CHECKS1

    subgraph CHECKS1["Vendor Checks"]
        direction LR
        G1["Required fields\nInvoice, PL, BoL"] --- G2["Supplier details\nName & address match"] --- G3["Buyer details\nName & address match"] --- G4["Reference numbers\nOrder, contract, PO"]
        G5["Product description\nMatches across docs"] --- G6["Shipping term\nFCA, CIF, FOB"] --- G7["Freight & insurance\nConsistent with term"] --- G8["Weights & quantities\nWithin tolerance"]
        G9["Container numbers\nNumbers & counts match"]
    end

    CHECKS1 --> H{Any issues found?}
    H -- No issues --> H1["Documents look good"]
    H -- Issues found --> H2["Flag for review"]
    H1 & H2 --> I["Human Review — resolve issues"]

    I --> J["Upload Customs Declaration (BoE)"]
    J --> K["AI Reads Customs Declaration"]
    K --> L["STAGE 2 — Customs Cross-Check"]

    L --> CHECKS2

    subgraph CHECKS2["Customs Checks"]
        direction LR
        L1["Party names\nMatch shipping docs"] --- L2["HS codes\nMatch all documents"] --- L3["Weights & qty\nMatch declaration"] --- L4["Duty calculation\nCorrect for proc. code"]
        L5["CIF value\nFOB + freight + ins."] --- L6["FOB value\nConsistent with invoice"] --- L7["Duty rate\n40E68/40C01/40D01"] --- L8["Shipping term\nMatches customs entry"]
        L9["Transport mode\nAir, sea, or road"] --- L10["Invoice & currency\nMatch customs entry"] --- L11["Country of origin\nConsistent with BoL"] --- L12["Declarant details\nName, address, reg."]
        L13["Insurance rate\nCorrect for transport"] --- L14["Tax concessions\nETLS eligibility + HS"] --- L15["VAT deferment\nHS vs deferment list"]
    end

    CHECKS2 --> M{Any issues found?}
    M -- No issues --> M1["Declaration verified"]
    M -- Issues found --> M2["Flag for review"]
    M1 & M2 --> N["Final Human Review"]

    N --> O{Outcome?}
    O -- All clear --> O1([Shipment approved])
    O -- Corrections needed --> O2([Send corrections to agent])

    %% STYLING
    classDef stageNode fill:#1e40af,color:#fff,stroke:#1e3a8a
    classDef checkNode fill:#1e293b,color:#e2e8f0,stroke:#334155
    classDef decisionNode fill:#78350f,color:#fff,stroke:#713f12
    classDef okNode fill:#14532d,color:#fff,stroke:#166534
    classDef flagNode fill:#7f1d1d,color:#fff,stroke:#991b1b
    classDef humanNode fill:#4a044e,color:#fff,stroke:#6b21a8
    classDef processNode fill:#065f46,color:#fff,stroke:#064e3b

    class G,L stageNode
    class G1,G2,G3,G4,G5,G6,G7,G8,G9,L1,L2,L3,L4,L5,L6,L7,L8,L9,L10,L11,L12,L13,L14,L15 checkNode
    class H,M,O decisionNode
    class H1,M1,O1 okNode
    class H2,M2,O2 flagNode
    class I,N humanNode
    class B,C,D,E,F,J,K processNode